  m_text: "<color=#44DD66>\u2713</color> \u2220 <b>Angulo 45\xB0     </b>  <color=#44EE66>\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588</color><color=#2A2A2A>\u2588\u2588</color> 
    <color=#44EE66>87%</color>\n   <size=72%><color=#888888>Muestras fuera de 45\xB0\xB15\xB0:
    18/200</color></size>\n\n<color=#44DD66>\u2713</color> \u2500 <b>Rectitud      
    </b>  <color=#44EE66>\u2588\u2588\u2588\u2588\u2588\u2588\u2588</color><color=#2A2A2A>\u2588\u2588\u2588</color> 
    <color=#44EE66>82%</color>\n   <size=72%><color=#888888>Desviacion max: 8.4 mm</color></size>\n\n<color=#44DD66>\u2713</color>
    \u25CF <b>Posicion       </b>  <color=#44EE66>\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588</color><color=#2A2A2A>\u2588\u2588</color> 
    <color=#44EE66>88%</color>\n   <size=72%><color=#888888>Desv. media al seam:
    9.2 mm</color></size>\n\n<color=#FF4444>\u2717</color> \u2194 <b>Cobertura     
    </b>  <color=#FFCC22>\u2588\u2588\u2588\u2588\u2588\u2588</color><color=#2A2A2A>\u2588\u2588\u2588\u2588\u2588\u2588</color> 
    <color=#FFCC22>65%</color>\n   <size=72%><color=#888888>Cobertura: 65% del seam</color></size>\n\n<color=#44DD66>\u2713</color>
    \u2590 <b>Continuidad    </b>  <color=#44EE66>\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588</color> 
    <color=#44EE66>100%</color>\n   <size=72%><color=#888888>Pausas > 500 ms: 0</color></size>\n\n<color=#FFCC22>~</color>
    \u2192 <b>Velocidad      </b>  <color=#FFCC22>\u2588\u2588\u2588\u2588\u2588\u2588\u2588</color><color=#2A2A2A>\u2588</color> 
    <color=#FFCC22>71%</color>\n   <size=72%><color=#888888>Vel. avance: 4.1 mm/s
    (ideal 3.0\xB11.5)</color></size>"
